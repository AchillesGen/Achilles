namespace achilles {

class ProcessGroup;

namespace SystemVariables {
    const std::string libPrefix = "@LIBPREFIX@";
    const std::string libSuffix = "@LIBSUFFIX@";
    const std::string pluginBase = libPrefix + "AchillesPlugin";
    const std::string pluginRegex = pluginBase + ".*\\" + libSuffix;
    const std::regex validPluginName(pluginRegex);
}

class PathVariables {
  public:
    void InitializeStandalone() {
        rootPath = "@INSTALLPATH@";
        libsPath = rootPath / "lib";
        sharePath = rootPath / "share/Achilles";
        fluxPath = sharePath / "flux";
        dataPath = sharePath / "data";
        defaultsPath = dataPath / "default";
    }

    void InitializePython(fs::path root, fs::path libs, fs::path data, fs::path flux) {
        rootPath = root;
		sharePath = root;
        libsPath = libs;
        dataPath = data;
        fluxPath = flux;
    }

    fs::path RootPath() const { return rootPath; }
    fs::path SharePath() const { return sharePath; }
    fs::path FluxPath() const { return fluxPath; }
    fs::path DataPath() const { return dataPath; }
    fs::path LibsPath() const { return libsPath; }
    fs::path CachePath() const { return cacheDefault; }

    static PathVariables &Instance();

  private:
    fs::path rootPath;
    fs::path libsPath;
    fs::path sharePath;
    fs::path fluxPath;
    fs::path dataPath;
    fs::path defaultsPath;
    const fs::path cacheDefault = ".achilles/cache";
};

namespace Filesystem {

std::vector<fs::path> AchillesPath();
std::string FindFile(const std::string &filename, const std::string &head);
std::string FindFlux(const std::string &filename, const std::string &head);

class Cache {
  public:
    Cache() = default;
    Cache(const fs::path &path) : m_path{path} {}
    Cache(const Cache &) = default;
    Cache(Cache &&) = default;
    Cache &operator=(const Cache &) = default;
    Cache &operator=(Cache &&) = default;
    ~Cache() = default;

    const fs::path &Path() const { return m_path; }
    fs::path &Path() { return m_path; }

    bool FindCachedState(std::size_t);
    template <typename T> bool SaveState(const T &object) {
        auto cachePath = Path() / fmt::format("{:x}", std::hash<T>{}(object));
        if(fs::exists(cachePath))
            spdlog::warn("Cache: Overwriting existing cache for {}", object);
        fs::create_directories(cachePath);
        return object.Save(cachePath);
    }
    template <typename T> bool LoadState(T& object) {
        auto cachePath = Path() / fmt::format("{:x}", std::hash<T>{}(object));
        if(!fs::exists(cachePath)) {
            spdlog::debug("Cache: Not found for {}", object);
            return false;
        }
        fs::create_directories(cachePath);
        return object.Load(cachePath);
    }

  private:
    fs::path m_path{PathVariables::Instance().CachePath()};
};

enum class FileType {
    any = -1,
    regular,
    directory,
    empty
};

std::vector<std::string> GetPluginPaths();

template<typename T>
bool is_type(const T &path, FileType type) {
    switch(type) {
        case FileType::any:
            return true;
        case FileType::regular:
            return fs::is_regular_file(path);
        case FileType::directory:
            return fs::is_directory(path);
        case FileType::empty:
            return fs::is_empty(path);
    }
    return false;
}

template<typename Func>
void RecurseDirectories(const fs::path &directory, Func f, FileType type = FileType::any) {
    // Plugin/search directories are optional and may not exist.
    std::error_code ec;
    if(!fs::is_directory(directory, ec)) return;
    for(const auto &file_path : fs::recursive_directory_iterator(directory, ec)) {
        if(ec) break;
        if(!is_type(file_path, type)) continue;
        f(file_path);
    }
}

bool CreateDirectories(const fs::path &path);

} // namespace Filesystem

} // namespace achilles

#endif
