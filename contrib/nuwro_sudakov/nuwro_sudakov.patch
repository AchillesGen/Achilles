 ////////////////////////////////////////
+// Sudakov veto cascade: bounds for the majorant
+////////////////////////////////////////
+
+double Interaction::nn_table_margin()
+{
+  // The tabulated cross sections are piecewise linear: the maximum over an
+  // interval is attained at a knot or an end point, so the bound is exact.
+  // The analytic parametrisations (Metropolis below 335 MeV, Cugnon) are
+  // bounded by dense sampling, with a small safety margin.
+  return (NN_xsec->param_value == 0 || NN_xsec->param_value == 3) ? 1.03 : 1.0;
+}
+
+double Interaction::NN_xsec_max( double Elo, double Ehi, bool ij_ )
+{
+  if( Elo < 0 ) Elo = 0;
+  if( Ehi < Elo ) Ehi = Elo;
+  vector<double> pts;
+  pts.push_back(Elo); pts.push_back(Ehi);
+  for( double x : NN_xsec->axis_values() ) if( x > Elo && x < Ehi ) pts.push_back(x);
+  if( NN_xsec->param_value == 0 || NN_xsec->param_value == 3 )
+    for( int i = 1; i < 256; i++ ) pts.push_back( Elo + (Ehi-Elo)*i/256.0 );
+  // the Metropolis branch is clamped at 30 MeV and switches to the table at 335 MeV
+  const double extra[] = {30*MeV, 335*MeV, 6*MeV, 4148*MeV};
+  for( double x : extra ) if( x > Elo && x < Ehi ) { pts.push_back(x*(1-1e-9)); pts.push_back(x*(1+1e-9)); }
+  double m = 0;
+  for( double E : pts )
+  {
+    double sii = 0, sij = 0;
+    get_NN_xsec( E, sii, sij );
+    m = max( m, ij_ ? sij : sii );
+  }
+  return m * nn_table_margin();
+}
+
+double Interaction::pion_xsec_max( int pdg, int target_is_proton, double Ek, double dens_lo, double dens_hi )
+{
+  vector<double> d;
+  d.push_back(dens_lo); d.push_back(dens_hi);
+  for( int k = 0; k < PD.n_density_knots(); k++ )
+  {
+    double x = PD.density_knot(k);
+    if( x > dens_lo && x < dens_hi ) d.push_back(x);
+  }
+  double m = 0;
+  for( double dens : d )
+  {
+    PD.set_density(dens);
+    PD.set_Ek(Ek);
+    double rii=PD.sij(0)*millibarn;
+    double rij=PD.sij(1)*millibarn;
+    double rabs=PD.sij(2)*millibarn;
+    double xn = 0, xp = 0;
+    switch(pdg)
+    {
+      case pdg_pi:   xn = xp = (rii+rij+rabs)/2; break;
+      case pdg_piP:  xn = rij+rabs; xp = rii;     break;
+      case -pdg_piP: xn = rii;      xp = rij+rabs;break;
+      default: break;
+    }
+    m = max( m, target_is_proton ? xp : xn );
+  }
+  return m;
+}
