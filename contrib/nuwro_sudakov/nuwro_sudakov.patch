     data_container* corr_func;                    //!< Correlation function for effective density.
     shell_sampler* shell_dist;                    //!< Shell sampler if primary vertex has a specific wavefuntion.
 
+    // ---- Sudakov veto cascade (kaskada_sudakov = 1) -----------------------------------
+    //! One particle in flight.  Its straight path is parametrised by the path length l
+    //! measured from the anchor point (position r0, time t0, travelled s0).
+    struct sud_track
+    {
+      particle p;                                 //!< Particle; p.r is its current position (l = lcur).
+      vec    r0, dir;                             //!< Anchor position and unit direction.
+      double t0, s0, v;                           //!< Anchor time, travelled at anchor, speed.
+      double lcur;                                //!< Path length already moved from the anchor.
+      double lexit;                               //!< Path length from the anchor to the nuclear surface.
+      double lc[2];                               //!< Next candidate per channel (0: n target, 1: p target); <0 none.
+      double seg_hi[2];                           //!< End of the segment the candidate was drawn in.
+      double gmax[2];                             //!< Majorant on that segment.
+    };
+    vector<sud_track> trk;                        //!< Particles in flight, ordered by global time on the fly.
+    double seg_len;                               //!< Segment length for the piecewise-constant majorant.
+    vector<double> dshape;                        //!< Density of the full nucleus on a radial grid.
+    double dgrid_h;                               //!< Grid spacing of dshape.
+    vector<double> corr_knots;                    //!< Knots of the correlation tables.
+    vector<pair<int,double> > wvar;               //!< Weight variations: (0: mfp scale, 1: NN xsec scale; value).
+    double wheadroom;                             //!< Majorant headroom so that every variation stays below it.
+
+  public:
+    vector<double> weights;                       //!< Event weights for the variations in kaskada_weights.
+    bool   weights_valid;                         //!< false if a branch with mfp redraws was used.
+    //! Sudakov statistics accumulated over all events of this process.
+    struct sud_stats_t { long events, proposals, accepted, blocked, blocked_state_change, violations,
+                         jail_midflight, finalize_fail, reanchors, segments; double max_ratio; };
+    static sud_stats_t sud_stats;
+    static void print_sud_stats(ostream &o);
+
+  private:
+    void   sud_init();                            //!< Precompute envelopes (called from the constructor).
+    bool   after_move();                          //!< Energy update and jail check after a move (move_particle body).
+    bool   corr_applies();                        //!< Are the correlation factor and mfp scale applied?
+    double dens_max(double rlo, double rhi);      //!< Upper bound of the full-nucleus density on [rlo,rhi].
+    double dens_min(double rlo, double rhi);      //!< Lower bound of the full-nucleus density on [rlo,rhi].
+    double sud_bound(sud_track &t, int c, double la, double lb); //!< Majorant for channel c on [la,lb].
+    void   sud_draw(sud_track &t, int c, double l0, double gmax, double shi); //!< Next candidate from l0.
+    void   sud_anchor(sud_track &t);              //!< Re-anchor at the current position and redraw candidates.
+    void   sud_add(particle &q);                  //!< Start tracking a particle from the parts queue.
+    double sud_next(sud_track &t, int &what);     //!< Path length of the next event: 0/1 candidate, 2 exit.
+    void   sud_move_to(sud_track &t, double l);   //!< Move straight to path length l (no stepping).
+    double var_factor(int v, bool nucleon_proj);  //!< Gamma'/Gamma for variation v.
+    bool   sud_cascade(int mode, int *nod_n1, double restore_scale);
+                                                  //!< Runs the queue with the veto algorithm.
+                                                  /*!< mode 1: particles with nucleon_id==1 leave without interacting.
+                                                       Returns true if a nucleon with nucleon_id==1 interacted. */
+    void   step_weights();                        //!< (a): likelihood-ratio weights of the current step.
+
   public:
     kaskada(params &p, event &e1, input_data *input);
