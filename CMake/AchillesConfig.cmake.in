@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# FindFilesystem is installed next to this file to provide std::filesystem
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(Filesystem)

find_dependency(fmt)
find_dependency(spdlog)
find_dependency(yaml-cpp)
find_dependency(HighFive)
find_dependency(HepMC3)
find_dependency(NuHepMC_CPPUtils)
if(@ACHILLES_ENABLE_GZIP@)
    find_dependency(ZLIB)
endif()
if(@ACHILLES_ENABLE_ROOT@)
    find_dependency(ROOT 6 COMPONENTS Core Hist)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AchillesTargets.cmake")
